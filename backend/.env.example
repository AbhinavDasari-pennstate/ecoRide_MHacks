# Neon pooled URL for the app. Use "local" to run an embedded Postgres (pip install -r requirements-dev.txt).
DATABASE_URL=local
# Neon direct (unpooled) URL, used only by scripts/seed.py to apply db/schema.sql.
DATABASE_URL_DIRECT=
GEMINI_API_KEY=
MAPS_SERVER_KEY=
# gemini | deterministic
PLANNER=deterministic
# template | gemini
EXPLAIN=template
