# Neon pooled URL for the app. Use "local" to run an embedded Postgres (pip install -r requirements-dev.txt).
DATABASE_URL=local
# Neon direct (unpooled) URL, required by scripts/migrate.py for remote databases.
DATABASE_URL_DIRECT=
# Optional local database directory. Default: %LOCALAPPDATA%/campus-rides-pg on Windows.
LOCAL_DATABASE_PATH=
GEMINI_API_KEY=
MAPS_SERVER_KEY=
# Shared token for trusted backend adapters. Leave empty ONLY for local demo development.
# This is not end-user login. Never put this token or a database URL in frontend code.
API_SERVICE_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# gemini | deterministic
PLANNER=deterministic
# template | gemini
EXPLAIN=template
