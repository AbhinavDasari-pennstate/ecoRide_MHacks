# Neon pooled URL for the app. Use "local" to run an embedded Postgres (pip install -r requirements-dev.txt).
DATABASE_URL=local
# Neon direct (unpooled) URL, used only by scripts/seed.py to apply db/schema.sql.
DATABASE_URL_DIRECT=
GEMINI_API_KEY=
MAPS_SERVER_KEY=
# gemini | deterministic
PLANNER=deterministic
# template | gemini
EXPLAIN=template

# --- voice agent + texts (README "Voice agent"); scripts/setup_voice.py fills the ELEVENLABS_* ids ---
# Set = protected routes need X-Api-Key; --prepare creates this before the API starts
# /health, /docs and /openapi.json remain public
API_TOKEN=
# https tunnel to this server, e.g. from `ngrok http 8000`
PUBLIC_URL=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_MCP_SERVER_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# Optional model and voice overrides
ELEVENLABS_LLM=gemini-2.5-flash
ELEVENLABS_VOICE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Trial accounts can only text a template id, e.g. sms_appointment_reminders
TWILIO_SMS_TEMPLATE=
# Team phones for the live demo (verified in Twilio on a trial), e.g. Alex=+17345551234,Maya=+12485556789
DEMO_PHONES=
