# Neon pooled URL for the app. Use "local" to run an embedded Postgres (pip install -r requirements-dev.txt).
DATABASE_URL=local
# Neon direct (unpooled) URL, required by scripts/migrate.py for remote databases.
DATABASE_URL_DIRECT=
# Optional local database directory. Default: %LOCALAPPDATA%/campus-rides-pg on Windows.
# Use a distinct ABSOLUTE path per checkout, e.g. C:/Users/abhin/ecoRide_MHacks/.local/postgres.
# The migration process and API server must use the same path.
LOCAL_DATABASE_PATH=
GEMINI_API_KEY=
MAPS_SERVER_KEY=
# Optional shared token for trusted backend adapters and operator tools.
# Empty disables adapter/demo operations. Browser accounts use their own cookies.
# Never put this token or a database URL in frontend code or a browser proxy.
API_SERVICE_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# Set true for every HTTPS deployment; false only for local HTTP development.
SESSION_COOKIE_SECURE=false
# gemini | deterministic
PLANNER=gemini
# Planner for the phone path only. deterministic answers in well under a second; gemini takes
# 5 to 20 seconds, which is a long silence on a call. Empty follows PLANNER.
VOICE_PLANNER=deterministic
# template | gemini
EXPLAIN=template

# --- voice agent + texts (README "Voice agent"); scripts/setup_voice.py fills the ELEVENLABS_* ids ---
# Same token as API_SERVICE_TOKEN (either name works); the voice agent sends it as X-Api-Key.
# --prepare creates this before the API starts
API_TOKEN=
# https tunnel to this server, e.g. from `ngrok http 8000`
PUBLIC_URL=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_MCP_SERVER_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# Optional model and voice overrides. ELEVENLABS_LLM must match the model selected in the
# ElevenLabs dashboard, or rerunning setup_voice.py reverts the agent to this value.
ELEVENLABS_LLM=deepseek-v41-flash
ELEVENLABS_VOICE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Trial accounts can only text a template id, e.g. sms_appointment_reminders
TWILIO_SMS_TEMPLATE=
# on | off. Text travellers and owners when a match forms, confirms or changes car.
# Off by default because turning it on sends real texts. Notices always show in the app.
NOTIFY_ON_MATCH=off
# Team phones for the live demo (verified in Twilio on a trial), e.g. Alex=+17345551234,Maya=+12485556789
DEMO_PHONES=
