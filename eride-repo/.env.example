# Local development uses the Vite /api proxy by default.
# Set BACKEND_URL in the server environment if FastAPI is not on port 8000.
# Never place database URLs or API_SERVICE_TOKEN in VITE_* variables.
# For a deployed frontend with an authenticated API gateway:
# VITE_API_BASE_URL=https://your-api.example.com
# Google Maps JavaScript API key for the live-location map. Browser keys are public:
# restrict it to the Maps JavaScript API and your site's URLs. Never reuse MAPS_SERVER_KEY here.
# VITE_GOOGLE_MAPS_BROWSER_KEY=
